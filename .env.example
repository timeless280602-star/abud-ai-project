# Native Web Chat images are disabled by default. See docs/native-image-generation.md.
# Explicitly verify endpoint, available model, n support and b64_json responses first.
ABUD_IMAGE_PROVIDER=
ABUD_IMAGE_ENDPOINT=
ABUD_IMAGE_MODEL=
ABUD_IMAGE_API_KEY=
ABUD_IMAGE_MAX_COUNT=1
# Creator quota bypass reuses the EXISTING verified Discord owner mapping in auth.py.
# No new Creator IDs, email allowlist, client role flag or bypass secret is accepted.

# Optional. Enables explicit "Cari web:" / "Cek fakta:" commands.
ABUD_TAVILY_API_KEY=

# Optional Canva Connect integration. Register the callback in Canva Developer Portal.
# Callback: <ABUD_BASE_URL>/web/chat/integrations/canva/callback
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=

# Optional Discord voice. Requires compose.voice.yaml and Whisper/Piper models.
# This uses the existing /chat API and 9router, independently of web voice's LLM setting.
ABUD_DISCORD_VOICE_ENABLED=false
# Set this only for a non-Compose deployment; Compose supplies the private worker URL.
ABUD_DISCORD_VOICE_WORKER_URL=

# Creator notifications (draft; enable when ready to test)
ABUD_NOTIFICATIONS_ENABLED=false
YOUTUBE_API_KEY=
ABUD_NOTIFICATIONS_INTERVAL=300
# Optional external TikTok provider: HMAC secret, at least 32 characters.
ABUD_TIKTOK_WEBHOOK_SECRET=

# Optional Abud Music: compose.music.yaml, separate from AI voice worker.
ABUD_MUSIC_ENABLED=false
ABUD_LAVALINK_URL=http://abud-lavalink:2333
ABUD_LAVALINK_PASSWORD=
# SoundCloud works without the optional YouTube plugin.
ABUD_MUSIC_SEARCH_SOURCE=soundcloud

# Optional community leveling; each guild opts in with /leveling setup.
ABUD_LEVELING_ENABLED=false

# Welcome + reaction roles. Enable Server Members Intent in Developer Portal first.
ABUD_ONBOARDING_ENABLED=false
