FROM python:3.11-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

COPY requirements-bot.txt .
RUN apt-get update && apt-get install -y --no-install-recommends fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir -r requirements-bot.txt
RUN groupadd --system --gid 10001 abudbot && useradd --system --uid 10001 --gid 10001 --home-dir /app --no-create-home abudbot

RUN mkdir -p /app/notifications /app/leveling /app/onboarding /app/tickets && chown 10001:10001 /app/notifications /app/leveling /app/onboarding /app/tickets

COPY --chown=10001:10001 app ./app

USER 10001:10001
CMD ["python", "-m", "app.bot"]
