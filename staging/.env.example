# Copy to repository-root .env.staging; replace every placeholder on the server.
# This example contains no real credentials. Never commit .env.staging.
ABUD_BASE_URL=https://staging.example.invalid
ABUD_SESSION_SECRET=replace-with-new-staging-only-random-secret
ABUD_INTERNAL_API_KEY=replace-with-another-staging-only-random-secret
GOOGLE_OAUTH_CLIENT_ID=replace-with-staging-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-staging-google-client-secret
# Existing auth startup still requires Discord OAuth settings, not a bot token.
DISCORD_OAUTH_CLIENT_ID=replace-with-staging-discord-client-id
DISCORD_OAUTH_CLIENT_SECRET=replace-with-staging-discord-client-secret
# Use a staging 9router endpoint reachable from inside the API container.
NINE_ROUTER_BASE_URL=https://router-staging.example.invalid/v1
NINE_ROUTER_API_KEY=replace-with-staging-router-api-key
NINE_ROUTER_MODEL=Abud-Combo

# Optional native images: disabled until staging provider compatibility is verified.
ABUD_IMAGE_PROVIDER=
ABUD_IMAGE_ENDPOINT=
ABUD_IMAGE_MODEL=
ABUD_IMAGE_API_KEY=
ABUD_IMAGE_MAX_COUNT=1
